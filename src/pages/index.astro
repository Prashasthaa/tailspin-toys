---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const filterCategories = await getAllCategories(getDatabase());
const filterPublishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
            <fieldset>
              <legend class="mb-4 text-lg font-semibold text-slate-100">Filter games</legend>
              <div class="grid gap-6 md:grid-cols-2">
                <div>
                  <span class="mb-2 block text-sm font-medium text-slate-200">Categories</span>
                  <div class="flex flex-wrap gap-3">
                    {filterCategories.map((category) => (
                      <label class="inline-flex items-center gap-2 text-sm text-slate-300">
                        <input
                          type="checkbox"
                          name="category"
                          value={category.id}
                          data-testid={`category-filter-${category.id}`}
                          class="h-4 w-4 rounded border-slate-600 bg-slate-700 text-blue-500 focus:ring-2 focus:ring-blue-500"
                        />
                        <span>{category.name}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div>
                  <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
                  <select
                    id="publisher-filter"
                    name="publisher"
                    data-testid="publisher-filter"
                    class="w-full rounded-lg border border-slate-600 bg-slate-700 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  >
                    <option value="">All publishers</option>
                    {filterPublishers.map((publisher) => (
                      <option value={publisher.id}>{publisher.name}</option>
                    ))}
                  </select>
                </div>
              </div>
              <div class="mt-4 flex items-center gap-4">
                <button
                  type="button"
                  data-testid="clear-game-filters"
                  class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  Clear filters
                </button>
                <p class="text-sm text-slate-400" data-testid="filter-results" aria-live="polite"></p>
              </div>
            </fieldset>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <p class="hidden py-8 text-center text-slate-300" data-testid="filtered-empty" role="status">
            No games match the selected filters.
          </p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));
  const clearButton = document.querySelector('[data-testid="clear-game-filters"]');
  const resultText = document.querySelector('[data-testid="filter-results"]');
  const emptyState = document.querySelector('[data-testid="filtered-empty"]');

  if (form instanceof HTMLFormElement && clearButton instanceof HTMLButtonElement) {
    const categories = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisher = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

    const applyFilters = () => {
      const selectedCategories = new Set(categories.filter((input) => input.checked).map((input) => input.value));
      const selectedPublisher = publisher?.value ?? '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(card.getAttribute('data-category-id') ?? '');
        const publisherMatches = selectedPublisher === '' || selectedPublisher === card.getAttribute('data-publisher-id');
        const visible = categoryMatches && publisherMatches;
        card.classList.toggle('hidden', !visible);
        if (visible) visibleCount += 1;
      });

      if (resultText) resultText.textContent = `${visibleCount} game${visibleCount === 1 ? '' : 's'} shown`;
      emptyState?.classList.toggle('hidden', visibleCount > 0);
    };

    const updateUrl = () => {
      const params = new URLSearchParams();
      categories.filter((input) => input.checked).forEach((input) => params.append('category', input.value));
      if (publisher?.value) params.set('publisher', publisher.value);
      const query = params.toString();
      history.replaceState(null, '', query ? `/?${query}` : '/');
      applyFilters();
    };

    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    categories.forEach((input) => { input.checked = selectedCategories.has(input.value); });
    if (publisher && params.has('publisher')) publisher.value = params.get('publisher') ?? '';
    form.addEventListener('change', updateUrl);
    clearButton.addEventListener('click', () => {
      categories.forEach((input) => { input.checked = false; });
      if (publisher) publisher.value = '';
      updateUrl();
    });
    applyFilters();
  }
</script>
